# Backend
ADMIN_PASSWORD=admin123456
MAX_UPLOAD_SIZE_MB=20

# Database
# DATABASE_URL=postgresql://user:password@localhost:5432/single_item_store

# S3-compatible object storage, for example RustFS.
# When S3_BUCKET, S3_ACCESS_KEY_ID, and S3_SECRET_ACCESS_KEY are present,
# uploads are stored in the bucket instead of local storage/img.
# S3_ENDPOINT=https://rustfs.example.com
# S3_REGION=auto
# S3_BUCKET=single-item-store
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_BASE_URL=https://cdn.example.com/single-item-store
# S3_KEY_PREFIX=uploads
# S3_FORCE_PATH_STYLE=true
