generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id                Int                @id @default(autoincrement())
  name              String
  slug              String             @unique
  isActive          Boolean            @default(false)
  settings          SiteSettings?
  mediaAssets       MediaAsset[]
  reviews           Review[]
  floatingPurchases FloatingPurchase[]
  productSkus       ProductSku[]
  orders            Order[]
  operationLogs     OperationLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model SiteSettings {
  id                 Int      @id @default(autoincrement())
  siteId             Int      @unique
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shopName           String
  title              String
  subtitle           String
  highlight          String
  serviceNote        String
  guarantee          Json
  productDescription String
  shippingNote       String
  reminder           String
  shippingTime       String
  salePrice          Float
  originalPrice      Float
  soldText           String
  marqueeText        String
  reviewTags         Json
  productVariants    Json
  heroImageCount     Int
  paymentSuccessMessage String @default("添加客服领取服用说明")
  customerServiceUrl String @default("")
  customerServiceQrCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MediaAsset {
  id         Int      @id @default(autoincrement())
  siteId     Int
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section    String
  sourceType String
  source     String
  alt        String
  sortOrder  Int      @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([siteId, section])
}

model Review {
  id             Int      @id @default(autoincrement())
  siteId         Int
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name           String
  content        String
  images         Json
  featuredOnHome Boolean  @default(false)
  homeOrder      Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId])
}

model FloatingPurchase {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content   String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

enum PaymentStatus {
  UNPAID
  PAYING
  PAID
  PAYMENT_FAILED
  REFUNDED

  @@map("StorePaymentStatus")
}

enum FulfillmentStatus {
  WAIT_SHIP
  SHIPPED

  @@map("StoreFulfillmentStatus")
}
model ProductSku {
  id            Int      @id @default(autoincrement())
  siteId        Int
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  skuCode       String
  name          String
  subtitle      String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal  @db.Decimal(10, 2)
  saleLabel     String
  highlight     String?
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([siteId, skuCode])
  @@index([siteId, enabled])
}

model Order {
  id                Int               @id @default(autoincrement())
  orderNo           String            @unique
  siteId            Int
  site              Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  skuId             Int?
  sku               ProductSku?       @relation(fields: [skuId], references: [id], onDelete: SetNull)
  skuCode           String
  skuName           String
  productName       String
  quantity          Int
  unitAmount        Decimal           @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  recipientName     String
  phone             String
  address           String
  paymentChannel    String
  paymentStatus     PaymentStatus     @default(UNPAID)
  thirdPartyTradeNo String?
  paidAt            DateTime?
  fulfillmentStatus FulfillmentStatus @default(WAIT_SHIP)
  logisticsCompany  String?
  logisticsNo       String?
  shippedAt         DateTime?
  refundedAt        DateTime?
  refundNote        String?
  refundMarkedBy    String?
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?
  idempotencyKey    String?
  operationLogs     OperationLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([siteId, idempotencyKey])
  @@index([siteId, createdAt])
  @@index([siteId, paymentStatus])
  @@index([siteId, fulfillmentStatus])
  @@index([siteId, deletedAt])
}

model PaymentSettings {
  id              Int      @id @default(autoincrement())
  gatewayUrl      String
  merchantId      String
  encryptedSecret String
  enabledChannels Json
  notifyUrl       String
  returnUrl       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OperationLog {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  actor     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([orderId])
}
